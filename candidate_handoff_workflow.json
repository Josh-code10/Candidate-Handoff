    {
      "parameters": {
        "jsCode": "// Normalise + compliance gate.\n// IMPORTANT: this node does NOT perform right-to-work / ID / background checks.\n// It verifies that the agency's CRM holds valid evidence that those checks were done.\n// The checks themselves stay with the agency's certified providers.\n\n// ---- Tunable demo defaults (assumptions, not legal rules: confirm with each agency) ----\nconst CONSENT_MAX_AGE_DAYS = 90;\nconst RTW_EXPIRY_WARN_DAYS = 30;\n\nconst input = $('Validate Input').first().json;\nconst candRes = $('Fetch Candidate').first().json;\nconst jobRes = $('Fetch Job').first().json;\nconst dupRes = $('Check Client ATS').first().json;\n\nconst cand = candRes.records?.[0]?.fields ?? null;\nconst job = jobRes.records?.[0]?.fields ?? null;\nconst dups = dupRes.records ?? [];\n\nconst ageDays = (d) => Math.floor((Date.now() - new Date(d).getTime()) / 86400000);\nconst daysUntil = (d) => Math.ceil((new Date(d).getTime() - Date.now()) / 86400000);\n\nconst blocks = [];   // any block = candidate cannot be sent\nconst warnings = []; // warnings go to the human reviewer\n\n// ---- Fail-safe: anything we cannot read or trust blocks the submission ----\nif (!input.input_valid) blocks.push('INVALID_INPUT');\nif (candRes.error || jobRes.error || dupRes.error) blocks.push('SOURCE_UNAVAILABLE');\nif (input.input_valid && !candRes.error && !cand) blocks.push('CANDIDATE_NOT_FOUND');\nif (input.input_valid && !jobRes.error && !job) blocks.push('JOB_NOT_FOUND');\nif (dups.length) blocks.push('ALREADY_SUBMITTED_TO_CLIENT');\n\nif (cand && job) {\n  // Schema check on the canonical record\n  const missing = ['full_name', 'email', 'country'].filter((k) => !cand[k]);\n  if (missing.length) blocks.push('RECORD_INCOMPLETE:' + missing.join('+'));\n\n  // 1. Consent to be submitted to THIS client\n  const consentOk = cand.consent_status === 'Granted' &&\n    (cand.consent_scope === 'ANY' || cand.consent_scope === job.client_name);\n  if (!consentOk) blocks.push('CONSENT_MISSING_OR_WRONG_SCOPE');\n  else if (!cand.consent_date || ageDays(cand.consent_date) > CONSENT_MAX_AGE_DAYS) blocks.push('CONSENT_STALE');\n\n  // 2. Right to work: verified, for the right country, not expired\n  if (cand.rtw_status !== 'Verified') {\n    blocks.push('RTW_NOT_VERIFIED');\n  } else {\n    if (cand.rtw_country !== job.country) blocks.push('RTW_WRONG_COUNTRY');\n    if (cand.rtw_expiry) {\n      const d = daysUntil(cand.rtw_expiry);\n      if (d < 0) blocks.push('RTW_EXPIRED');\n      else if (d <= RTW_EXPIRY_WARN_DAYS) warnings.push('RTW_EXPIRES_IN_' + d + '_DAYS');\n    }\n  }\n\n  // 3. Identity\n  if (cand.id_status !== 'Verified') blocks.push('ID_NOT_VERIFIED');\n\n  // 4. Role-specific background check (only when the job requires it)\n  if (job.requires_dbs && cand.dbs_status !== 'Clear') blocks.push('BACKGROUND_CHECK_NOT_CLEAR');\n\n  // 5. References\n  if ((cand.references_received || 0) < (job.min_references || 0)) blocks.push('REFERENCES_INSUFFICIENT');\n\n  // 6. Cross-border data transfer\n  if (cand.country !== job.country && !cand.cross_border_consent) blocks.push('CROSS_BORDER_CONSENT_MISSING');\n}\n\nconst decision = blocks.length ? 'BLOCK' : (warnings.length ? 'REVIEW_WITH_WARNINGS' : 'PASS');\n\nreturn [{\n  json: {\n    candidate_code: input.candidate_code,\n    job_code: input.job_code,\n    recruiter: input.recruiter,\n    decision,\n    reasons: blocks,\n    warnings,\n    // Data minimisation: only what the client's ATS needs, built only if not blocked\n    ats_payload: decision === 'BLOCK' ? null : {\n      agency_ref: input.candidate_code,\n      full_name: cand.full_name,\n      email: cand.email,\n      job_code: input.job_code,\n      status: 'Submitted',\n      submitted_at: new Date().toISOString(),\n      compliance_summary: 'Consent, right to work, ID' + (job.requires_dbs ? ', background check' : '') +\n        ' and references verified' + (warnings.length ? ' | warnings: ' + warnings.join(', ') : '')\n    }\n  }\n}];\n"
      },

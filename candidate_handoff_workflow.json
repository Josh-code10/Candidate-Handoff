      "id": "6bfc2e4c-2b1c-4218-9507-192f5cb39daa",
      "name": "Check Client ATS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,

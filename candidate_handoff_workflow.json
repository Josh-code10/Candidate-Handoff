      "parameters": {
        "jsCode": "// Pillar D: validate and sanitise input BEFORE anything touches a formula or a model.\nconst body = $('Webhook').first().json.body || {};\nconst re = /^[A-Z]{2,6}-\\d{1,6}$/;\nconst cand = String(body.candidate_code || '').trim().toUpperCase();\nconst job = String(body.job_code || '').trim().toUpperCase();\nconst ok = re.test(cand) && re.test(job);\n\nreturn [{\n  json: {\n    input_valid: ok,\n    // bad input is swapped for a harmless placeholder so it can never reach an Airtable formula\n    candidate_code: ok ? cand : 'INVALID-0',\n    job_code: ok ? job : 'INVALID-0',\n    recruiter: String(body.recruiter || 'unknown').slice(0, 60).replace(/[^\\w .@-]/g, '')\n  }\n}];\n"
      },
      "id": "0723ddfe-bc30-4917-9b82-34997e9f4a16",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
